Terminals unused in grammar

    COLON
    SKIP


Grammar

    0 $accept: program $end

    1 program: lines

    2 lines: lines ENDL line
    3      | lines ENDL
    4      | line
    5      | ENDL

    6 line: label
    7     | label directive
    8     | directive
    9     | label instruction
   10     | instruction

   11 directive: SECTION SYMBOL
   12          | GLOBAL SYMLIST
   13          | WEAK SYMLIST
   14          | TYPE SYMBOL type
   15          | WORD EXPR_LIST
   16          | EXTERN SYMLIST
   17          | ASCII STRING
   18          | EQU SYMBOL ',' equ_expr
   19          | END

   20 type: FUNC
   21     | OBJ

   22 equ_expr: equ_expr '+' equ_primary
   23         | equ_expr '-' equ_primary
   24         | equ_primary

   25 equ_primary: SYMBOL
   26            | NUM

   27 instruction: noop_opcode
   28            | RET
   29            | IRET
   30            | PUSH REG
   31            | POP REG
   32            | NOT REG
   33            | CALL jmp_operand
   34            | JMP jmp_operand
   35            | jmp_opcode REG ',' REG ',' jmp_operand
   36            | tworeg_opcode REG ',' REG
   37            | LD operand ',' REG
   38            | ST REG ',' operand
   39            | CSRRD SREG ',' REG
   40            | CSRWR REG ',' SREG
   41            | INC REG
   42            | INC SYMBOL

   43 operand: '$' NUM
   44        | '$' SYMBOL
   45        | NUM
   46        | SYMBOL
   47        | REG
   48        | '[' REG ']'
   49        | '[' REG '+' NUM ']'
   50        | '[' REG '+' SYMBOL ']'

   51 jmp_operand: NUM
   52            | SYMBOL

   53 noop_opcode: HALT
   54            | INT

   55 tworeg_opcode: ADD
   56              | SUB
   57              | MUL
   58              | DIV
   59              | MOD
   60              | SHL
   61              | SHR
   62              | AND
   63              | XOR
   64              | OR
   65              | XCHG

   66 jmp_opcode: BEQ
   67           | BNE
   68           | BGT

   69 label: SYMBOL ':'

   70 SYMLIST: SYMBOL
   71        | SYMLIST ',' SYMBOL

   72 EXPR_LIST: SYMBOL
   73          | NUM
   74          | EXPR_LIST ',' SYMBOL
   75          | EXPR_LIST ',' NUM


